@echo off
chcp 65001 >nul
title ماژول مستقل دفترچه تلفن و سانترال حامی
color 0A

echo ==============================================================================
echo       ماژول مستقل دفترچه تلفن و سانترال ویپ سامانه حامی (Hami Beta 1.1786.1)
echo                  اجرای مستقیم بدون نیاز به باز کردن برنامه اصلی
echo ==============================================================================
echo.

cd /d "%~dp0"

set "PHONEBOOK_URL=http://localhost:3000/?standalone=true"

:: بررسی وجود مرورگر اج یا کروم برای باز کردن پنجره اختصاصی وب‌اپ
echo [*] در حال اجرای ماژول دفترچه تلفن و سانترال به صورت پنجره مستقل...

where msedge >nul 2>nul
if %errorlevel% equ 0 (
    start "" msedge --app="%PHONEBOOK_URL%"
    goto :FINISH
)

where chrome >nul 2>nul
if %errorlevel% equ 0 (
    start "" chrome --app="%PHONEBOOK_URL%"
    goto :FINISH
)

:: در غیر این صورت باز کردن در مرورگر پیش‌فرض سیستم
start "" "%PHONEBOOK_URL%"

:FINISH
echo.
echo ==============================================================================
echo [موفقیت] ماژول دفترچه تلفن در مرورگر شما به صورت پنجره مستقل باز گردید.
echo نشانی مستقیم: %PHONEBOOK_URL%
echo ==============================================================================
echo.
timeout /t 5 >nul
exit /b
