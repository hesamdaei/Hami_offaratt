@echo off
chcp 65001 >nul
title سامانه لجستیک و ترابری حامی - سرور شبکه محلی (LAN)
color 0B

echo ==============================================================================
echo          سامانه یکپارچه لجستیک و مدیریت ناوگان حامی (نسخه ویندوز ۱۱)
echo                 راه اندازی سرور محلی و اشتراک گذاری در شبکه LAN
echo ==============================================================================
echo.

:: رفتن به مسیر پوشه اسکریپت (محل فایل پروژه)
cd /d "%~dp0"

:: بررسی وجود نرم افزار Node.js
where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [خطا] نرم افزار Node.js روی این سیستم یافت نشد!
    echo.
    echo برای اجرای سامانه روی ویندوز، ابتدا باید Node.js (نسخه LTS) را نصب نمایید.
    echo می توانید آن را رایگان از وب سایت زیر دانلود و نصب کنید:
    echo   https://nodejs.org
    echo.
    echo پس از اتمام نصب Node.js، سیستم را ری استارت کرده یا مجدداً این فایل را اجرا کنید.
    echo ==============================================================================
    pause
    exit /b
)

:: بررسی وابستگی ها (node_modules)
if not exist "node_modules" (
    echo [*] پوشه وابستگی ها (node_modules) یافت نشد.
    echo [*] در حال نصب بسته های مورد نیاز (npm install)... لطفاً چند لحظه شکیبا باشید.
    call npm install
    if %errorlevel% neq 0 (
        echo [خطا] در نصب بسته های سامانه خطایی رخ داد. اتصال اینترنت خود را بررسی کنید.
        pause
        exit /b
    )
    echo [*] بسته های برنامه با موفقیت نصب شدند.
    echo.
)

:: بررسی پوشه dist و ساخت برنامه در صورت نیاز
if not exist "dist\index.html" (
    echo [*] فایل های خروجی برنامه (dist) یافت نشد. در حال ساخت و کامپایل سامانه (npm run build)...
    call npm run build
    if %errorlevel% neq 0 (
        echo [خطا] در کامپایل برنامه مشکلی پیش آمد.
        pause
        exit /b
    )
    echo [*] سامانه با موفقیت بیلد و آماده اجرا گردید.
    echo.
)

:: استخراج IP های فعال شبکه سیستم از طریق پاورشل
echo [*] در حال شناسایی کارت های شبکه و آدرس های IP سیستم شما...
echo.
echo ------------------------------------------------------------------------------
echo   آدرس های اتصال به سامانه حامی در شبکه:
echo.
echo   [1] روی همین سیستم (سرور):
echo       http://localhost:3000
echo.
echo   [2] روی سایر سیستم ها، لپ تاپ ها و گوشی های متصل به وای فای یا کابل شبکه:
powershell -NoProfile -Command "Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -notlike '127.*' -and $_.IPAddress -notlike '169.254.*' } | ForEach-Object { Write-Host '      -> http://' $_.IPAddress ':3000  (' $_.InterfaceAlias ')' -ForegroundColor Cyan }"
echo ------------------------------------------------------------------------------
echo.
echo [*] نکته: چنانچه سیستم های دیگر متصل نمی شوند، یک بار فایل SETUP_FIREWALL.bat را
echo     به عنوان Administrator اجرا کنید تا پورت 3000 در فایروال ویندوز 11 باز شود.
echo.

:: باز کردن خودکار مرورگر در کامپیوتر سرور
start "" http://localhost:3000

echo [*] سرور شبکه محلی در حال اجراست... (این پنجره را نبندید)
echo     برای توقف سرور کلیدهای Ctrl + C را بفشارید.
echo.

node lan-server.cjs
pause
