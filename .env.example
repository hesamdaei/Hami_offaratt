# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & Messenger Environment Variables
# Server-side tokens for messenger bots (prevents browser exposure)
BALE_BOT_TOKEN=""
EITAA_BOT_TOKEN=""

# Secret key for server-side HMAC token generation and verification
SERVER_HMAC_SECRET="change-this-to-a-secure-random-secret-for-production"

# CORS Allowed Origins (comma-separated, leave blank for local development defaults)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,tauri://localhost"

# ==============================================================================
# پیکربندی سرور ایمیل واقعی (Real SMTP Mailer for Password Recovery)
# ==============================================================================
# برای ارسال فیزیکی ایمیل بازیابی گذرواژه به جیمیل شخصی (hesam.daei@gmail.com):
# ۱. وارد اکانت گوگل خود شوید: https://myaccount.google.com/security
# ۲. بخش "تأیید دو مرحله‌ای" (2-Step Verification) را فعال کنید.
# ۳. در نوار جستجوی تنظیمات، عبارت "App passwords" (رمزهای عبور برنامه) را جستجو کنید.
# ۴. یک رمز ۱۶ رقمی اختصاصی بسازید و آن را بدون تغییر در فیلد SMTP_PASS زیر وارد کنید.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="hesam.daei@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="\"سامانه مدیریت تردد و ترابری حامی بار\" <hesam.daei@gmail.com>"

